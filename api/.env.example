# GitLab CI/CD Variables : Settings > CI/CD > Variables
# All should be marked Protected + Masked where possible.

# Azure service principal used by CI/CD to deploy the Function App
AZURE_CLIENT_ID=<appId from az ad sp create-for-rbac>
AZURE_CLIENT_SECRET=<password from az ad sp create-for-rbac>
AZURE_TENANT_ID=<tenant from az ad sp create-for-rbac>
AZURE_SUBSCRIPTION_ID=<Azure subscription ID>

GOOGLE_CALENDAR_ID=calendar-id@group.calendar.google.com

# GOOGLE_SERVICE_ACCOUNT_KEY stored as a base64-encoded string. (multiline gitlab masking not reliable)
GOOGLE_SERVICE_ACCOUNT_KEY=<base64-encoded service account JSON>

# Google Workspace user to impersonate via domain-wide delegation (must have write access to the calendar)
GOOGLE_IMPERSONATED_USER=technologie@ageei.org

# Shared secret between Directus webhook and this function (configured in Directus Flow/webhook settings)
WEBHOOK_SECRET=your-random-webhook-secret
